<?xml version="1.0" encoding="utf-8"?>
<!--
  Core forum, authentication, official trade, image host, mail, update, and built-in API domains
  strictly enforce HTTPS (cleartextTrafficPermitted="false").
  Base cleartext remains permitted solely because user-supplied restock merchant URLs, self-hosted
  LAN FlareSolverr instances (e.g. http://192.168.1.10:8191), and tokenless self-hosted probe
  panels can use arbitrary hostnames/IPs that cannot be statically enumerated in XML.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">nodeseek.com</domain>
        <domain includeSubdomains="true">nodeseek.org</domain>
        <domain includeSubdomains="true">nodeimage.com</domain>
        <domain includeSubdomains="true">seek.li</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">cloudflare.com</domain>
        <domain includeSubdomains="true">frankfurter.dev</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">lowendtalk.com</domain>
    </domain-config>
</network-security-config>
