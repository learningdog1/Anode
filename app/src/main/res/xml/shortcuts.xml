<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_check_in"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_monochrome"
        android:shortcutShortLabel="@string/shortcut_check_in_short"
        android:shortcutLongLabel="@string/shortcut_check_in_long"
        android:shortcutDisabledMessage="@string/shortcut_check_in_disabled">
        <intent
            android:action="com.nodeseek.app.action.SHORTCUT_CHECK_IN"
            android:targetPackage="com.nodeseek.app"
            android:targetClass="com.nodeseek.app.MainActivity" />
    </shortcut>

