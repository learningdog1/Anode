<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude all local sandbox storage (session snapshot, device UA cache, encrypted vaults,
  DataStore settings/API keys, Room database, and WebView cookies) from Android Auto Backup
  and adb backup on API 26-30. Users should rely on the built-in JSON backup/restore flow.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
