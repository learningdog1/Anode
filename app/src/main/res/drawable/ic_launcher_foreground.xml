<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Right Pillar (Periwinkle Cobalt Depth Layer) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,32 L73,73"
        android:strokeLineCap="round"
        android:strokeWidth="8.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="73"
                android:endY="73"
                android:startX="54"
                android:startY="32"
                android:type="linear">
                <item
                    android:color="#FF9BB2FF"
                    android:offset="0" />
                <item
                    android:color="#FF5878F5"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Pillar (Crisp Luminous Ice White) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M35,73 L54,32"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="8.6" />

    <!-- Floating Anode Core Crossbar (Electric Cyan-Cobalt) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M50.3,61.5 L57.7,61.5"
        android:strokeLineCap="round"
        android:strokeWidth="6.0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="61"
                android:endY="61.5"
                android:startX="47"
                android:startY="61.5"
                android:type="linear">
                <item
                    android:color="#FF3FE8DC"
                    android:offset="0" />
                <item
                    android:color="#FF6BA2FF"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
